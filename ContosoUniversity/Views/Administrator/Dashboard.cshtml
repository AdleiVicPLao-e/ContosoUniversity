@model ContosoUniversity.ViewModels.AdminDashboardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
}

<h2>Administrator Dashboard</h2>

<!-- Summary Statistics Cards -->
<div class="row">
    <div class="col-md-2">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalStudents</h4>
                        <p class="card-text">Students</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">@Model.NewEnrollmentsThisMonth new this month</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalInstructors</h4>
                        <p class="card-text">Instructors</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-chalkboard-teacher fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">@Model.AverageCoursesPerInstructor avg courses</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalCourses</h4>
                        <p class="card-text">Courses</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-book fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">@Model.ActiveCourses active</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalDepartments</h4>
                        <p class="card-text">Departments</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-building fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">Academic departments</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.EnrollmentGrowthRate.ToString("P2")</h4>
                        <p class="card-text">Growth Rate</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-chart-line fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">Enrollment growth</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-white bg-dark mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.SystemHealth</h4>
                        <p class="card-text">System Health</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-heartbeat fa-2x"></i>
                    </div>
                </div>
                <small class="text-white-50">@Model.SystemAlerts.Count alerts</small>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <!-- Left Column -->
    <div class="col-md-6">
        <!-- Quick Actions -->
        <!-- Quick Actions -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">
            <i class="fas fa-bolt me-2"></i>Quick Actions
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("ManageCourses", "Administrator")" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-book me-1"></i>Manage Courses
                    </a>
                    <a href="@Url.Action("ManageDepartments", "Administrator")" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-building me-1"></i>Manage Departments
                    </a>
                    <a href="@Url.Action("ManageInstructors", "Administrator")" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-chalkboard-teacher me-1"></i>Manage Instructors
                    </a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("ManageStudents", "Administrator")" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-users me-1"></i>Manage Students
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

        <!-- System Alerts -->
        <div class="card mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>System Alerts
                </h5>
                @{
                    string alertBadgeClass = Model.SystemAlerts.Count == 0 ? "success" : 
                                           Model.SystemAlerts.Count(a => !a.IsResolved && a.Priority == "High") > 0 ? "danger" : "warning";
                }
                <span class="badge bg-@alertBadgeClass">
                    @Model.SystemAlerts.Count(a => !a.IsResolved) Active
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.SystemAlerts.Any(a => !a.IsResolved))
                {
                    <div class="list-group list-group-flush">
                        @foreach (var alert in Model.SystemAlerts.Where(a => !a.IsResolved).Take(6))
                        {
                            string alertIcon = alert.AlertType == "Warning" ? "exclamation-triangle" : alert.AlertType == "Error" ? "exclamation-circle" : "info-circle";
                            string alertColor = alert.AlertType == "Warning" ? "warning" : alert.AlertType == "Error" ? "danger" : "info";
                            string priorityBadgeClass = alert.Priority == "High" ? "danger" : alert.Priority == "Medium" ? "warning" : "secondary";
                            
                            <div class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="me-3">
                                        <i class="fas fa-@alertIcon text-@alertColor"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@alert.Message</h6>
                                        <small class="text-muted">@alert.Timestamp.ToString("MMM dd, yyyy h:mm tt")</small>
                                    </div>
                                    <span class="badge bg-@priorityBadgeClass ms-2">
                                        @alert.Priority
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                        <p class="text-muted mb-0">No active system alerts</p>
                    </div>
                }
            </div>
        </div>

        <!-- Instructor Workload -->
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-tachometer-alt me-2"></i>Instructor Workload
                </h5>
            </div>
            <div class="card-body p-0">
                @if (Model.InstructorWorkload.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var instructor in Model.InstructorWorkload.Take(5))
                        {
                            string workloadBadgeClass = instructor.WorkloadLevel == "High" ? "danger" : 
                                                      instructor.WorkloadLevel == "Medium" ? "warning" : "success";
                            
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@instructor.InstructorName</h6>
                                        <small class="text-muted">@instructor.DepartmentName</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@workloadBadgeClass">
                                            @instructor.CoursesTeaching courses
                                        </span>
                                        <div class="small text-muted">@instructor.TotalStudents students</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-0">No instructor data available</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-md-6">
        <!-- Recent Activities -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-clock me-2"></i>Recent Activities
                </h5>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs" id="recentTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="enrollments-tab" data-bs-toggle="tab" data-bs-target="#enrollments" type="button" role="tab" aria-controls="enrollments" aria-selected="true">
                            Enrollments (@Model.RecentEnrollments.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="courses-tab" data-bs-toggle="tab" data-bs-target="#courses" type="button" role="tab" aria-controls="courses" aria-selected="false">
                            Courses (@Model.RecentCourses.Count)
                        </button>
                    </li>
                </ul>
                <div class="tab-content mt-3">
                    <div class="tab-pane fade show active" id="enrollments" role="tabpanel" aria-labelledby="enrollments-tab">
                        @if (Model.RecentEnrollments.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var enrollment in Model.RecentEnrollments.Take(6))
                                {
                                    string gradeBadgeClass = enrollment.Grade.HasValue ? "success" : "secondary";
                                    string gradeDisplay = enrollment.Grade?.ToString() ?? "No Grade";
                                    
                                    <div class="list-group-item px-0">
                                        <div class="d-flex w-100 justify-content-between">
                                            <div>
                                                <h6 class="mb-1">@enrollment.Student.FullName</h6>
                                                <p class="mb-1">Enrolled in <strong>@enrollment.Course.Title</strong></p>
                                                <small class="text-muted">@enrollment.Course.Department.Name</small>
                                            </div>
                                            <span class="badge bg-@gradeBadgeClass align-self-start">
                                                @gradeDisplay
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No recent enrollments</p>
                        }
                    </div>
                    <div class="tab-pane fade" id="courses" role="tabpanel" aria-labelledby="courses-tab">
                        @if (Model.RecentCourses.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var course in Model.RecentCourses.Take(6))
                                {
                                    <div class="list-group-item px-0">
                                        <h6 class="mb-1">@course.Title</h6>
                                        <p class="mb-1 text-muted">@course.CourseID - @course.Department.Name</p>
                                        <small>Credits: @course.Credits</small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No recent courses</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Department Statistics -->
        <div class="card mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-pie me-2"></i>Department Overview
                </h5>
                <small class="text-muted">Top @Math.Min(5, Model.DepartmentStatistics.Count) of @Model.DepartmentStatistics.Count</small>
            </div>
            <div class="card-body p-0">
                @if (Model.DepartmentStatistics.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Department</th>
                                    <th>Courses</th>
                                    <th>Students</th>
                                    <th>Budget</th>
                                    <th>Ratio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.DepartmentStatistics.Take(5))
                                {
                                    string progressBarClass = dept.BudgetUtilization > 0.8m ? "bg-danger" : 
                                                           dept.BudgetUtilization > 0.5m ? "bg-warning" : "bg-success";
                                    
                                    <tr>
                                        <td>
                                            <strong>@dept.DepartmentName</strong>
                                            <br />
                                            <small class="text-muted">@dept.DepartmentHead</small>
                                        </td>
                                        <td>@dept.TotalCourses</td>
                                        <td>@dept.TotalStudents</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                    <div class="progress-bar @progressBarClass" 
                                                         style="width: @(dept.BudgetUtilization * 100)%;" 
                                                         role="progressbar" 
                                                         aria-valuenow="@(dept.BudgetUtilization * 100)" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                    </div>
                                                </div>
                                                <small>@(dept.BudgetUtilization.ToString("P0"))</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@dept.StudentToInstructorRatio:1</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-0">No department data available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Popular Courses -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-fire me-2"></i>Most Popular Courses
                </h5>
                <small class="text-muted">@Model.PopularCourses.Count courses</small>
            </div>
            <div class="card-body">
                @if (Model.PopularCourses.Any())
                {
                    <div class="row g-3">
                        @foreach (var course in Model.PopularCourses.Take(6))
                        {
                            string borderClass = course.Status == "Full" ? "warning" : 
                                               course.Status == "Low Enrollment" ? "danger" : "success";
                            string progressBarClass = course.FillRate > 0.9m ? "bg-warning" : 
                                                    course.FillRate > 0.5m ? "bg-info" : "bg-success";
                            string statusBadgeClass = course.Status == "Full" ? "warning" : 
                                                    course.Status == "Low Enrollment" ? "danger" : "success";
                            
                            <div class="col-md-4">
                                <div class="card h-100 border-@borderClass">
                                    <div class="card-body">
                                        <h6 class="card-title">@course.CourseTitle</h6>
                                        <p class="card-text text-muted small">@course.CourseCode - @course.DepartmentName</p>
                                        
                                        <div class="mb-2">
                                            <small class="text-muted">Instructor:</small>
                                            <div class="fw-bold">@course.InstructorName</div>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small>Enrollment</small>
                                                <small class="fw-bold">@course.EnrolledStudents/@course.Capacity</small>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @progressBarClass" 
                                                     style="width: @(course.FillRate * 100)%;"
                                                     role="progressbar"
                                                     aria-valuenow="@(course.FillRate * 100)"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge bg-@statusBadgeClass">
                                                @course.Status
                                            </span>
                                            <small class="text-muted">@course.FillRate.ToString("P0") full</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-0">No course data available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["Success"]
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Initialize Bootstrap toast
        document.addEventListener('DOMContentLoaded', function () {
            var successToast = document.getElementById('successToast');
            if (successToast) {
                var toast = new bootstrap.Toast(successToast);
                toast.show();
            }

            // Initialize tabs if needed
            var triggerTabList = [].slice.call(document.querySelectorAll('#recentTabs button'));
            triggerTabList.forEach(function (triggerEl) {
                var tabTrigger = new bootstrap.Tab(triggerEl);
                triggerEl.addEventListener('click', function (event) {
                    event.preventDefault();
                    tabTrigger.show();
                });
            });
        });
    </script>
}