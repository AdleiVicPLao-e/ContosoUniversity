@model ContosoUniversity.Models.Course

@{
    ViewBag.Title = "Delete Course";
}

<h2>Delete Course</h2>

<h3>Are you sure you want to delete this course?</h3>
<div>
    <h4>Course Information</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Course ID:</dt>
        <dd>@Model.CourseID</dd>
        
        <dt>Title:</dt>
        <dd>@Model.Title</dd>
        
        <dt>Credits:</dt>
        <dd>@Model.Credits</dd>
        
        <dt>Department:</dt>
        <dd>@Model.Department.Name</dd>
        
        <dt>Enrolled Students:</dt>
        <dd>@Model.EnrolledStudents</dd>
        
        <dt>Status:</dt>
        <dd>
            <span class="label label-@(Model.IsActive ? "success" : "default")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </dd>
    </dl>

    @if (Model.EnrolledStudents > 0)
    {
        <div class="alert alert-warning">
            <strong>Warning:</strong> This course has @Model.EnrolledStudents enrolled students. 
            Deleting this course will also remove all student enrollments.
        </div>
    }

    @using (Html.BeginForm("DeleteCourseConfirmed", "Administrator", new { id = Model.CourseID }))
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" />
            @Html.ActionLink("Cancel", "ManageCourses", "Administrator", null, new { @class = "btn btn-default" })
        </div>
    }
</div>