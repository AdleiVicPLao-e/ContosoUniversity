@model ContosoUniversity.Models.Course

@{
    ViewBag.Title = "Delete Course";
}

<h2>Delete Course</h2>

<h3>Are you sure you want to delete this course?</h3>
<div>
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Course Information</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Course ID:</dt>
                <dd class="col-sm-9">@Model.CourseID</dd>

                <dt class="col-sm-3">Title:</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Credits:</dt>
                <dd class="col-sm-9">@Model.Credits</dd>

                <dt class="col-sm-3">Department:</dt>
                <dd class="col-sm-9">@Model.Department.Name</dd>

                <dt class="col-sm-3">Enrolled Students:</dt>
                <dd class="col-sm-9">@Model.EnrolledStudents</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </dd>
            </dl>

            @if (Model.EnrolledStudents > 0)
            {
                <div class="alert alert-warning">
                    <strong>Warning:</strong> This course has @Model.EnrolledStudents enrolled students.
                    Deleting this course will also remove all student enrollments.
                </div>
            }

            @using (Html.BeginForm("DeleteCourseConfirmed", "Administrator", new { id = Model.CourseID }))
            {
                @Html.AntiForgeryToken()

                <div class="mt-3">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    @Html.ActionLink("Cancel", "ManageCourses", "Administrator", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }
        </div>
    </div>
</div>