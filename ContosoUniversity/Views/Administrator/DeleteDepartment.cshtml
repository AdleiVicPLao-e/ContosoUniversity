@model ContosoUniversity.Models.Department

@{
    ViewBag.Title = "Delete Department";
}

<h2 class="mb-4 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Department</h2>

@if (!string.IsNullOrEmpty(ViewBag.ConcurrencyErrorMessage))
{
    <div class="alert alert-danger">
        @ViewBag.ConcurrencyErrorMessage
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Department Information</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name:</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Budget:</dt>
            <dd class="col-sm-8">@String.Format("{0:C}", Model.Budget)</dd>

            <dt class="col-sm-4">Start Date:</dt>
            <dd class="col-sm-8">@Model.StartDate.ToString("MMMM dd, yyyy")</dd>

            <dt class="col-sm-4">Administrator:</dt>
            <dd class="col-sm-8">
                @if (Model.Administrator != null)
                {
                    @Model.Administrator.FullName
                }
                else
                {
                    <span class="text-muted">Not assigned</span>
                }
            </dd>

            <dt class="col-sm-4">Total Courses:</dt>
            <dd class="col-sm-8">@Model.Courses.Count</dd>
        </dl>
    </div>
</div>

@if (Model.Courses.Count > 0)
{
    <div class="alert alert-warning">
        <strong>Warning:</strong> This department has @Model.Courses.Count courses.
        Deleting this department will also remove all associated courses and enrollments.
    </div>
}

@using (Html.BeginForm("DeleteDepartment", "Administrator", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.DepartmentID)
    @Html.HiddenFor(model => model.RowVersion)

    <div class="d-flex gap-2">
        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Cancel", "ManageDepartments", "Administrator", null, new { @class = "btn btn-secondary" })
    </div>
}
