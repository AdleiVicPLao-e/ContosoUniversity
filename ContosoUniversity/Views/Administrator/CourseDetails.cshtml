@model ContosoUniversity.Models.Course

@{
    ViewBag.Title = "Course Details";
}

<h2>Course Details</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Course Information</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Course ID:</dt>
                    <dd class="col-sm-8">@Model.CourseID</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Description:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</dd>

                    <dt class="col-sm-4">Credits:</dt>
                    <dd class="col-sm-8">@Model.Credits</dd>

                    <dt class="col-sm-4">Capacity:</dt>
                    <dd class="col-sm-8">@Model.Capacity students</dd>

                    <dt class="col-sm-4">Enrolled:</dt>
                    <dd class="col-sm-8">@Model.EnrolledStudents students</dd>

                    <dt class="col-sm-4">Available Spots:</dt>
                    <dd class="col-sm-8">@Model.AvailableSpots</dd>

                    <dt class="col-sm-4">Fill Rate:</dt>
                    <dd class="col-sm-8">@Model.FillRate.ToString("P0")</dd>

                    <dt class="col-sm-4">Department:</dt>
                    <dd class="col-sm-8">@Model.Department.Name</dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Teaching Team</h3>
            </div>
            <div class="card-body">
                @if (Model.Instructors.Any())
                {
                    <ul class="list-group">
                        @foreach (var instructor in Model.Instructors)
                        {
                            <li class="list-group-item">
                                <strong>@instructor.FullName</strong>
                                @if (!string.IsNullOrEmpty(instructor.Specialization))
                                {
                                    <br /><small class="text-muted">@instructor.Specialization</small>
                                }
                                @if (instructor.OfficeAssignment != null)
                                {
                                    <br /><small class="text-muted">Office: @instructor.OfficeAssignment.Location</small>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No instructors assigned to this course.</p>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Enrollment Statistics</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-6">Total Enrollments:</dt>
                    <dd class="col-sm-6">@Model.Enrollments.Count</dd>

                    <dt class="col-sm-6">Graded Students:</dt>
                    <dd class="col-sm-6">@Model.Enrollments.Count(e => e.Grade.HasValue)</dd>

                    <dt class="col-sm-6">Ungraded Students:</dt>
                    <dd class="col-sm-6">@Model.Enrollments.Count(e => !e.Grade.HasValue)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        @Html.ActionLink("Edit", "EditCourse", "Administrator", new { id = Model.CourseID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Back to Course List", "ManageCourses", "Administrator", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("Back to Dashboard", "Dashboard", "Administrator", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>