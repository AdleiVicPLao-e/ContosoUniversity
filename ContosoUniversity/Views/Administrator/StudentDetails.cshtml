@model ContosoUniversity.Models.Student

@{
    ViewBag.Title = "Student Details";
}

<h2 class="mb-4"><i class="bi bi-person me-2"></i>Student Details</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Basic Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FullName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FullName)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UserName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UserName)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EnrollmentDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.EnrollmentDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentCode)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.StudentCode)</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Course Enrollments</h5>
    </div>
    <div class="card-body">
        @if (Model.Enrollments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th>Credits</th>
                        <th>Department</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model.Enrollments)
                    {
                        <tr>
                            <td>@enrollment.Course.Title</td>
                            <td>@enrollment.Course.Credits</td>
                            <td>@enrollment.Course.Department.Name</td>
                            <td>
                                <span class="badge bg-@(enrollment.Grade.HasValue ? "success" : "warning")">
                                    @(enrollment.Grade.HasValue ? enrollment.Grade.ToString() : "No Grade")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">This student is not enrolled in any courses.</p>
        }
    </div>
</div>

<div class="mt-4 d-flex flex-wrap gap-2">
    @Html.ActionLink("Edit", "EditStudent", "Administrator", new { id = Model.ID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to List", "ManageStudents", "Administrator", null, new { @class = "btn btn-secondary" })
</div>
