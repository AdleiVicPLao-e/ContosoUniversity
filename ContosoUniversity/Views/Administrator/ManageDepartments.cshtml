@model IEnumerable<ContosoUniversity.Models.Department>

@{
    ViewBag.Title = "Manage Departments";
}

<h2 class="mb-4"><i class="bi bi-building me-2"></i>Manage Departments</h2>

<p>
    @Html.ActionLink("Create New Department", "CreateDepartment", "Administrator", null, new { @class = "btn btn-primary mb-3" })
</p>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Departments</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Budget</th>
                    <th>Start Date</th>
                    <th>Administrator</th>
                    <th>Courses</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@String.Format("{0:C}", item.Budget)</td>
                        <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.Administrator != null)
                            {
                                @item.Administrator.FullName
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </td>
                        <td>@item.Courses.Count</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                @Html.ActionLink("Details", "DepartmentDetails", "Administrator", new { id = item.DepartmentID }, new { @class = "btn btn-outline-info" })
                                @Html.ActionLink("Edit", "EditDepartment", "Administrator", new { id = item.DepartmentID }, new { @class = "btn btn-outline-primary" })
                                @Html.ActionLink("Delete", "DeleteDepartment", "Administrator", new { id = item.DepartmentID }, new { @class = "btn btn-outline-danger" })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="mt-4 d-flex flex-wrap gap-2">
    @Html.ActionLink("Back to Dashboard", "Dashboard", "Administrator", null, new { @class = "btn btn-secondary" })
    @Html.ActionLink("Manage Courses", "ManageCourses", "Administrator", null, new { @class = "btn btn-outline-primary" })
</div>
