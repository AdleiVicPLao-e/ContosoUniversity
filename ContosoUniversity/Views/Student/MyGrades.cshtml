@model IEnumerable<ContosoUniversity.Models.Enrollment>

@{
    ViewBag.Title = "My Grades";
}

<div class="container my-4">
    <h2 class="mb-4">My Grades</h2>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Course Grades</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Code</th>
                            <th>Course Title</th>
                            <th>Credits</th>
                            <th>Department</th>
                            <th>Grade</th>
                            <th>Grade Points</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in Model)
                        {
                            // Debug: Check for nulls
                            int courseId = enrollment?.Course?.CourseID ?? 0;
                            var courseTitle = enrollment?.Course?.Title ?? "Unknown Course";
                            var credits = enrollment?.Course?.Credits ?? 0;
                            var department = enrollment?.Course?.Department?.Name ?? "No Department";
                            var grade = enrollment?.Grade;

                            var gradeBadgeClass = GetGradeBadgeClass(grade);
                            var gradeDisplay = GetGradeDisplay(grade);

                            <tr>
                                <td>@courseId</td>
                                <td>@courseTitle</td>
                                <td>@credits</td>
                                <td>@department</td>
                                <td>
                                    <span class="badge @gradeBadgeClass px-3 py-2 fs-6">
                                        @gradeDisplay
                                    </span>
                                </td>
                                <td>
                                    @if (grade.HasValue)
                                    {
                                        <span class="fw-bold text-dark">@GetGradePoints(grade.Value).ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (grade.HasValue)
                                    {
                                        <span class="text-success fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-info">
                                            <i class="bi bi-clock-fill me-1"></i>In Progress
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">Grade Distribution</h6>
                    </div>
                    <div class="card-body">
                        @{
                            var gradedCourses = Model.Where(e => e?.Grade.HasValue == true && e?.Course != null).ToList();
                            var gradeGroups = gradedCourses
                                .Where(e => e.Grade.HasValue)
                                .GroupBy(e => e.Grade.Value)
                                .OrderBy(g => g.Key)
                                .Select(g => new { Grade = g.Key, Count = g.Count() })
                                .ToList();
                        }

                        @if (gradeGroups.Any())
                        {
                            foreach (var gradeGroup in gradeGroups)
                            {
                                var badgeClass = GetGradeBadgeClass(gradeGroup.Grade);
                                var gradeDisplay = GetGradeDisplay(gradeGroup.Grade);

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @badgeClass">@gradeDisplay</span>
                                    <span class="fw-bold">@gradeGroup.Count course(s)</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No graded courses yet</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">GPA Summary</h6>
                    </div>
                    <div class="card-body">
                        @{
                            if (gradedCourses.Any())
                            {
                                var totalCredits = gradedCourses.Sum(e => e?.Course?.Credits ?? 0);
                                var totalGradePoints = gradedCourses.Sum(e =>
                                    e?.Grade.HasValue == true ? GetGradePoints(e.Grade.Value) * (e?.Course?.Credits ?? 0) : 0);
                                var gpa = totalCredits > 0 ? totalGradePoints / totalCredits : 0;

                                var gpaClass = gpa >= 3.5m ? "success" : gpa >= 2.5m ? "warning" : "danger";

                                <div class="text-center">
                                    <h3 class="text-@gpaClass mb-2">@gpa.ToString("F2")</h3>
                                    <p class="mb-1"><strong>Current GPA</strong></p>
                                    <div class="small text-muted">
                                        Based on @gradedCourses.Count graded courses
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <p class="mb-1"><strong>Total Credits:</strong> @totalCredits</p>
                                    <p class="mb-1"><strong>Graded Courses:</strong> @gradedCourses.Count</p>
                                    <p class="mb-0"><strong>In Progress:</strong> @Model.Count(e => e?.Grade.HasValue != true)</p>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No graded courses yet. Your GPA will appear once grades are available.</p>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <h4><i class="bi bi-info-circle me-2"></i>No Enrollments Found</h4>
            <p class="mb-3">You are not enrolled in any courses yet.</p>
            @Html.ActionLink("Browse Available Courses", "AvailableCourses", null, new { @class = "btn btn-primary" })
        </div>
    }

    <div class="mt-4 d-flex gap-2">
        @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("My Schedule", "MySchedule", null, new { @class = "btn btn-outline-primary" })
        @Html.ActionLink("Browse Courses", "AvailableCourses", null, new { @class = "btn btn-primary" })
    </div>
</div>

@functions {
    private decimal GetGradePoints(ContosoUniversity.Models.Grade grade)
    {
        switch (grade)
        {
            case ContosoUniversity.Models.Grade.A:
                return 4.0m;
            case ContosoUniversity.Models.Grade.B:
                return 3.0m;
            case ContosoUniversity.Models.Grade.C:
                return 2.0m;
            case ContosoUniversity.Models.Grade.D:
                return 1.0m;
            case ContosoUniversity.Models.Grade.F:
                return 0.0m;
            default:
                return 0.0m;
        }
    }

    private string GetGradeBadgeClass(ContosoUniversity.Models.Grade? grade)
    {
        if (!grade.HasValue)
            return "bg-warning text-dark";

        switch (grade.Value)
        {
            case ContosoUniversity.Models.Grade.A:
                return "bg-success text-white";
            case ContosoUniversity.Models.Grade.B:
                return "bg-info text-white";
            case ContosoUniversity.Models.Grade.C:
                return "bg-warning text-dark";
            case ContosoUniversity.Models.Grade.D:
                return "bg-danger text-white";
            case ContosoUniversity.Models.Grade.F:
                return "bg-dark text-white";
            default:
                return "bg-secondary text-white";
        }
    }

    private string GetGradeDisplay(ContosoUniversity.Models.Grade? grade)
    {
        if (!grade.HasValue)
            return "Not Graded";

        switch (grade.Value)
        {
            case ContosoUniversity.Models.Grade.A:
                return "A";
            case ContosoUniversity.Models.Grade.B:
                return "B";
            case ContosoUniversity.Models.Grade.C:
                return "C";
            case ContosoUniversity.Models.Grade.D:
                return "D";
            case ContosoUniversity.Models.Grade.F:
                return "F";
            default:
                return grade.Value.ToString();
        }
    }
}