@model IEnumerable<ContosoUniversity.Models.Course>

@{
    ViewBag.Title = "Available Courses";
}

<div class="container my-4">
    <h2 class="mb-4">Available Courses</h2>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-@(course.AvailableSpots > 0 ? "success" : "danger")">
                        <div class="card-header bg-@(course.AvailableSpots > 0 ? "success" : "danger") text-white">
                            <h5 class="card-title mb-0">@course.Title</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Course ID:</strong> @course.CourseID</p>
                            <p><strong>Department:</strong> @course.Department.Name</p>
                            <p><strong>Credits:</strong> @course.Credits</p>
                            <p>
                                <strong>Available Spots:</strong>
                                <span class="badge bg-@(course.AvailableSpots > 0 ? "success" : "danger")">
                                    @course.AvailableSpots / @course.Capacity
                                </span>
                            </p>
                            <p><strong>Instructors:</strong> @string.Join(", ", course.Instructors.Select(i => i.FullName))</p>

                            @if (!string.IsNullOrEmpty(course.Description))
                            {
                                <p><strong>Description:</strong> @course.Description</p>
                            }
                        </div>
                        <div class="card-footer text-end">
                            @if (course.AvailableSpots > 0 && course.IsActive)
                            {
                                using (Html.BeginForm("EnrollInCourse", "Student", new { courseId = course.CourseID }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">Enroll Now</button>
                                }
                            }
                            else if (!course.IsActive)
                            {
                                <span class="badge bg-secondary">Not Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Full</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">
            <h4>No Available Courses</h4>
            <p>There are currently no courses open for enrollment. Please check back later.</p>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }

    <div class="mt-4 d-flex gap-2">
        @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("View My Grades", "MyGrades", null, new { @class = "btn btn-primary" })
    </div>
</div>
