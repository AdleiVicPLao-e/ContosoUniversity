@model ContosoUniversity.Models.Student

@{
    ViewBag.Title = "Student Dashboard";
}

<div class="container my-4">
    <h2>Welcome, @Model.FirstMidName!</h2>

    <div class="row g-4 mt-3">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">My Courses</div>
                <div class="card-body text-center">
                    <h4>@Model.Enrollments.Count</h4>
                    <p>Currently enrolled</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white">Student ID</div>
                <div class="card-body text-center">
                    <h4>@Model.StudentCode</h4>
                    <p>Your student code</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-header bg-info text-white">Enrollment Date</div>
                <div class="card-body text-center">
                    <h4>@Model.EnrollmentDate.ToString("MMM yyyy")</h4>
                    <p>Since you joined</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-header bg-warning text-dark">Graded Courses</div>
                <div class="card-body text-center">
                    <h4>@Model.Enrollments.Count(e => e.Grade.HasValue)</h4>
                    <p>Courses with grades</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><strong>My Current Courses</strong></div>
                <div class="card-body">
                    @if (Model.Enrollments.Any())
                    {
                        <div class="list-group">
                            @foreach (var e in Model.Enrollments.Take(5))
                            {
                                <div class="list-group-item">
                                    <h5 class="mb-1">@e.Course.Title</h5>
                                    <small>Course ID: @e.Course.CourseID | Credits: @e.Course.Credits</small><br />
                                    <strong>Grade:</strong>
                                    @if (e.Grade.HasValue)
                                    {
                                        <span class="badge bg-success">@e.Grade</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">No Grade Yet</span>
                                    }
                                    @using (Html.BeginForm("DropCourse", "Student", new { enrollmentId = e.EnrollmentID }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger float-end" onclick="return confirm('Drop this course?')">Drop</button>
                                    }
                                </div>
                            }
                        </div>
                        if (Model.Enrollments.Count > 5)
                        {
                            <p class="text-center text-muted mt-2">
                                Showing 5 of @Model.Enrollments.Count courses
                            </p>
                        }
                    }
                    else
                    {
                        <p>You are not enrolled in any courses yet.</p>
                        @Html.ActionLink("Browse Available Courses", "AvailableCourses", null, new { @class = "btn btn-primary" })
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light"><strong>Quick Actions</strong></div>
                <div class="list-group list-group-flush">
                    @Html.ActionLink("View All My Grades", "MyGrades", null, new { @class = "list-group-item list-group-item-action" })
                    @Html.ActionLink("Browse Available Courses", "AvailableCourses", null, new { @class = "list-group-item list-group-item-action" })
                    @Html.ActionLink("My Course Schedule", "MySchedule", null, new { @class = "list-group-item list-group-item-action" })
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light"><strong>Student Information</strong></div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Full Name:</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>
                        <dt class="col-sm-4">Username:</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>
                        <dt class="col-sm-4">Student ID:</dt>
                        <dd class="col-sm-8">@Model.StudentCode</dd>
                        <dt class="col-sm-4">Enrollment Date:</dt>
                        <dd class="col-sm-8">@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }
</div>
