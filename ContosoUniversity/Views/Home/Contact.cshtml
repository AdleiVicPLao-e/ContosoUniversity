@{
    ViewBag.Title = "Contact Us";
}

<div class="container">
    <div class="page-header text-center">
        <h1>Contact Contoso University</h1>
        <p class="lead">We're here to help you with any questions or concerns</p>
    </div>

    <div class="row">
        <!-- Contact Form -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm p-4">
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        @Html.Label("Name", "Your Name", new { @class = "control-label" })
                        @Html.TextBox("Name", "", new { @class = "form-control", required = "required" })
                    </div>

                    <div class="form-group">
                        @Html.Label("Email", "Email Address", new { @class = "control-label" })
                        @Html.TextBox("Email", "", new { @class = "form-control", type = "email", required = "required" })
                    </div>

                    <div class="form-group">
                        @Html.Label("Subject", "Subject", new { @class = "control-label" })
                        <select class="form-control" name="Subject" required>
                            <option value="">Select a subject...</option>
                            <option value="Admissions">Admissions Inquiry</option>
                            <option value="Financial Aid">Financial Aid</option>
                            <option value="Academic Programs">Academic Programs</option>
                            <option value="Student Services">Student Services</option>
                            <option value="Technical Support">Technical Support</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        @Html.Label("Message", "Message", new { @class = "control-label" })
                        <textarea class="form-control" name="Message" rows="6" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg">Send Message</button>
                }
            </div>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3 mb-3">
                <h4>Contact Information</h4>
                <p><span class="glyphicon glyphicon-map-marker"></span> 123 University Avenue, Seattle, WA 98101</p>
                <p><span class="glyphicon glyphicon-phone"></span> (206) 555-1234</p>
                <p><span class="glyphicon glyphicon-envelope"></span> <a href="mailto:info@contoso.edu">info@contoso.edu</a></p>
            </div>
            <div class="card shadow-sm p-3 mb-3">
                <h4>Office Hours</h4>
                <p>Mon-Fri: 8:00 AM - 6:00 PM</p>
                <p>Sat: 9:00 AM - 1:00 PM</p>
                <p>Sun: Closed</p>
            </div>
            <div class="card shadow-sm p-3">
                <h4>Emergency Contacts</h4>
                <p>Campus Security: (206) 555-9999</p>
                <p>Health Services: (206) 555-8888</p>
                <p>Counseling Center: (206) 555-7777</p>
            </div>
        </div>
    </div>
</div>
