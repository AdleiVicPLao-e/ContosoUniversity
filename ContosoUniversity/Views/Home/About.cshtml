@{
    ViewBag.Title = "About Contoso University";
}

<div class="container">
    <div class="page-header text-center">
        <h1>About Contoso University</h1>
        <p class="lead">Excellence in education since 1995</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm p-3 mb-3">
                <h4><span class="glyphicon glyphicon-star"></span> Our Mission</h4>
                <p>Providing high-quality education that transforms lives and communities.</p>
            </div>
            <div class="card shadow-sm p-3 mb-3">
                <h4><span class="glyphicon glyphicon-time"></span> Our History</h4>
                <p>Founded in 1995, growing from a small college to a comprehensive university.</p>
            </div>
            <div class="card shadow-sm p-3 mb-3">
                <h4><span class="glyphicon glyphicon-book"></span> Academic Programs</h4>
                <ul>
                    <li>Computer Science and IT</li>
                    <li>Business Administration</li>
                    <li>Engineering Sciences</li>
                    <li>Liberal Arts</li>
                    <li>Health Sciences</li>
                    <li>Education</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3 mb-3">
                <h4>Quick Facts</h4>
                <p>Founded: 1995</p>
                <p>Location: Seattle, WA</p>
                <p>Campus Size: 150 acres</p>
                <p>S/F Ratio: 15:1</p>
                <p>Accreditation: NWCCU</p>
            </div>
            <div class="card shadow-sm p-3">
                <h4>Our Values</h4>
                <ul>
                    <li>Academic Excellence</li>
                    <li>Student-Centered</li>
                    <li>Global Perspective</li>
                    <li>Community</li>
                    <li>Innovation</li>
                </ul>
            </div>
        </div>
    </div>
</div>
