@{
    ViewBag.Title = "About Contoso University";
}

<div class="jumbotron">
    <h1>About Contoso University</h1>
    <p class="lead">Excellence in education since 1995</p>
</div>

<div class="row">
    <div class="col-md-8">
        <h2>Our Mission</h2>
        <p>
            Contoso University is dedicated to providing high-quality education that transforms lives
            and communities through innovative teaching, research, and service. We strive to create
            an inclusive learning environment that fosters intellectual growth and personal development.
        </p>

        <h2>Our History</h2>
        <p>
            Founded in 1995, Contoso University has grown from a small liberal arts college to a
            comprehensive university offering undergraduate, graduate, and professional programs
            across various disciplines. Our commitment to academic excellence and student success
            has remained constant throughout our growth.
        </p>

        <h2>Academic Programs</h2>
        <p>
            We offer a wide range of programs including:
        </p>
        <ul>
            <li>Computer Science and Information Technology</li>
            <li>Business Administration and Management</li>
            <li>Engineering and Applied Sciences</li>
            <li>Liberal Arts and Humanities</li>
            <li>Health Sciences and Nursing</li>
            <li>Education and Teacher Preparation</li>
        </ul>

        <h2>Student Enrollment Statistics</h2>
        <div class="row text-center">
            <div class="col-md-4">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h3 class="panel-title">Total Students</h3>
                    </div>
                    <div class="panel-body">
                        <h4>@ViewBag.TotalStudents</h4>
                        <p>Currently Enrolled</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel panel-success">
                    <div class="panel-heading">
                        <h3 class="panel-title">Faculty Members</h3>
                    </div>
                    <div class="panel-body">
                        <h4>@ViewBag.TotalInstructors</h4>
                        <p>Dedicated Educators</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h3 class="panel-title">Courses Offered</h3>
                    </div>
                    <div class="panel-body">
                        <h4>@ViewBag.TotalCourses</h4>
                        <p>Diverse Curriculum</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Quick Facts</h3>
            </div>
            <div class="panel-body">
                <dl>
                    <dt>Founded:</dt>
                    <dd>1995</dd>

                    <dt>Location:</dt>
                    <dd>Seattle, Washington</dd>

                    <dt>Campus Size:</dt>
                    <dd>150 acres</dd>

                    <dt>Student-Faculty Ratio:</dt>
                    <dd>15:1</dd>

                    <dt>Accreditation:</dt>
                    <dd>Northwest Commission on Colleges and Universities</dd>
                </dl>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Our Values</h3>
            </div>
            <div class="panel-body">
                <ul class="list-unstyled">
                    <li><span class="glyphicon glyphicon-education text-primary"></span> Academic Excellence</li>
                    <li><span class="glyphicon glyphicon-user text-success"></span> Student-Centered Approach</li>
                    <li><span class="glyphicon glyphicon-globe text-info"></span> Global Perspective</li>
                    <li><span class="glyphicon glyphicon-heart text-danger"></span> Community Engagement</li>
                    <li><span class="glyphicon glyphicon-flash text-warning"></span> Innovation & Creativity</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="well">
            <h3>Visit Our Campus</h3>
            <p>
                We invite you to visit our beautiful campus and experience the Contoso University
                difference firsthand. Schedule a campus tour or attend one of our information
                sessions to learn more about our programs and community.
            </p>
            @Html.ActionLink("Contact Us", "Contact", "Home", null, new { @class = "btn btn-primary" })
        </div>
    </div>
</div>