@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron text-center" style="background: linear-gradient(135deg, #3498db, #2980b9); color: white; padding: 60px 20px;">
    <h1>Contoso University</h1>
    <p class="lead">Welcome to Contoso University Management System</p>

    @if (ViewBag.CurrentUser != null)
    {
        <div class="alert alert-info" style="margin-top: 20px;">
            <h4>Welcome back, @ViewBag.CurrentUser.FullName!</h4>
            <p>You are logged in as <strong>@ViewBag.UserRole</strong>.</p>

            @{
                string dashboardController = "Home";
                if (ViewBag.CurrentUser.IsAdministrator)
                {
                    dashboardController = "Administrator";
                }
                else if (ViewBag.CurrentUser.IsInstructor)
                {
                    dashboardController = "Instructor";
                }
                else if (ViewBag.CurrentUser.IsStudent)
                {
                    dashboardController = "Student";
                }
            }


            @Html.ActionLink("Go to Dashboard", "Dashboard", dashboardController, null, new { @class = "btn btn-primary btn-lg" })
        </div>
    }
    else
    {
        <p>Please log in to access the university management system.</p>
        @Html.ActionLink("Login", "Login", "Account", null, new { @class = "btn btn-primary btn-lg" })
    }
</div>

<div class="container">
    <div class="row text-center mt-5">
        <div class="col-md-4">
            <i class="glyphicon glyphicon-education" style="font-size:3em;color:#3498db;"></i>
            <h4>Quality Education</h4>
            <p class="text-muted">Since 1995</p>
        </div>
        <div class="col-md-4">
            <i class="glyphicon glyphicon-user" style="font-size:3em;color:#2ecc71;"></i>
            <h4>Expert Faculty</h4>
            <p class="text-muted">Dedicated professionals</p>
        </div>
        <div class="col-md-4">
            <i class="glyphicon glyphicon-certificate" style="font-size:3em;color:#9b59b6;"></i>
            <h4>Accredited Programs</h4>
            <p class="text-muted">Nationally recognized</p>
        </div>
    </div>
</div>
