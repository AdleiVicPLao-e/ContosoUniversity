@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron">
    <h1>Contoso University</h1>
    <p class="lead">Welcome to Contoso University Management System</p>

    @if (ViewBag.CurrentUser != null)
    {
        <div class="alert alert-info">
            <h4>Welcome back, @ViewBag.CurrentUser.FullName!</h4>
            <p>You are logged in as <strong>@ViewBag.UserRole</strong>.</p>

            @if (ViewBag.CurrentUser.IsAdministrator)
            {
                @Html.ActionLink("Go to Dashboard", "Dashboard", "Administrator", null, new { @class = "btn btn-primary btn-lg" })
            }
            else if (ViewBag.CurrentUser.IsInstructor)
            {
                @Html.ActionLink("Go to Dashboard", "Dashboard", "Instructor", null, new { @class = "btn btn-primary btn-lg" })
            }
            else if (ViewBag.CurrentUser.IsStudent)
            {
                @Html.ActionLink("Go to Dashboard", "Dashboard", "Student", null, new { @class = "btn btn-primary btn-lg" })
            }
        </div>
    }
    else
    {
        <p>Please log in to access the university management system.</p>
        @Html.ActionLink("Login", "Login", "Account", null, new { @class = "btn btn-primary btn-lg" })
    }
</div>

<div class="row">
    <div class="col-md-4">
        <h2>For Students</h2>
        <p>
            Access your courses, view grades, and manage your academic schedule.
        </p>
        @if (ViewBag.CurrentUser == null)
        {
            <p>@Html.ActionLink("Student Login", "Login", "Account", null, new { @class = "btn btn-default" })</p>
        }
        else if (ViewBag.CurrentUser.IsStudent)
        {
            <p>@Html.ActionLink("Student Dashboard", "Dashboard", "Student", null, new { @class = "btn btn-success" })</p>
        }
    </div>
    <div class="col-md-4">
        <h2>For Instructors</h2>
        <p>
            Manage your courses, grade students, and track academic progress.
        </p>
        @if (ViewBag.CurrentUser == null)
        {
            <p>@Html.ActionLink("Instructor Login", "Login", "Account", null, new { @class = "btn btn-default" })</p>
        }
        else if (ViewBag.CurrentUser.IsInstructor)
        {
            <p>@Html.ActionLink("Instructor Dashboard", "Dashboard", "Instructor", null, new { @class = "btn btn-success" })</p>
        }
    </div>
    <div class="col-md-4">
        <h2>For Administrators</h2>
        <p>
            Manage courses, departments, users, and system-wide operations.
        </p>
        @if (ViewBag.CurrentUser == null)
        {
            <p>@Html.ActionLink("Admin Login", "Login", "Account", null, new { @class = "btn btn-default" })</p>
        }
        else if (ViewBag.CurrentUser.IsAdministrator)
        {
            <p>@Html.ActionLink("Admin Dashboard", "Dashboard", "Administrator", null, new { @class = "btn btn-success" })</p>
        }
    </div>
</div>