<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Contoso University</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Contoso University", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })

            <!-- Hamburger button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar content -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contact", "Contact", "Home", null, new { @class = "nav-link" })</li>

                    @if (ViewBag.CurrentUser != null)
                    {
                        <!-- Admin menu -->
                        if (ViewBag.CurrentUser.IsAdministrator)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li>@Html.ActionLink("Dashboard", "Dashboard", "Administrator", null, new { @class = "dropdown-item" })</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("Manage Courses", "ManageCourses", "Administrator", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Manage Departments", "ManageDepartments", "Administrator", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Manage Instructors", "ManageInstructors", "Administrator", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Manage Students", "ManageStudents", "Administrator", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Manage Users", "ManageUsers", "Administrator", null, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }

                        <!-- Instructor menu -->
                        if (ViewBag.CurrentUser.IsInstructor)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="instructorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Instructor
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="instructorDropdown">
                                    <li>@Html.ActionLink("Dashboard", "Dashboard", "Instructor", null, new { @class = "dropdown-item" })</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("My Courses", "MyCourses", "Instructor", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("My Schedule", "MySchedule", "Instructor", null, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }

                        <!-- Student menu -->
                        if (ViewBag.CurrentUser.IsStudent)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="studentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Student
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="studentDropdown">
                                    <li>@Html.ActionLink("Dashboard", "Dashboard", "Student", null, new { @class = "dropdown-item" })</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("My Grades", "MyGrades", "Student", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Available Courses", "AvailableCourses", "Student", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("My Schedule", "MySchedule", "Student", null, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <!-- Right side -->
                <ul class="navbar-nav ms-auto">
                    @if (ViewBag.CurrentUser != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i>
                                @ViewBag.CurrentUser.FullName
                                <span class="badge bg-@GetRoleBadgeColor(ViewBag.CurrentUser.PrimaryRole) ms-2">@ViewBag.CurrentUser.PrimaryRole</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                        <i class="bi bi-person me-2"></i>Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Settings", "Account")">
                                        <i class="bi bi-gear me-2"></i>Settings
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger border-0 bg-transparent" style="cursor: pointer;">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Login", "Login", "Account", null, new { @class = "nav-link" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Warning"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
        <hr />
        <footer class="text-center py-3">
            <p>&copy; @DateTime.Now.Year - Contoso University</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <!-- Add this script to ensure dropdowns work -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize all dropdowns
            var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
            var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
                return new bootstrap.Dropdown(dropdownToggleEl);
            });
        });
    </script>
</body>
</html>

@functions {
    private string GetRoleBadgeColor(ContosoUniversity.Models.Person.UserRole role)
    {
        switch (role)
        {
            case ContosoUniversity.Models.Person.UserRole.Administrator:
                return "danger";
            case ContosoUniversity.Models.Person.UserRole.Instructor:
                return "warning";
            case ContosoUniversity.Models.Person.UserRole.Student:
                return "info";
            default:
                return "secondary";
        }
    }
}