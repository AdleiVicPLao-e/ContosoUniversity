@{
    ViewBag.Title = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string dashboardUrl = "";
    if (ViewBag.CurrentUser != null)
    {
        if (ViewBag.CurrentUser.IsAdministrator)
        {
            dashboardUrl = Url.Action("Dashboard", "Administrator");
        }
        else if (ViewBag.CurrentUser.IsInstructor)
        {
            dashboardUrl = Url.Action("Dashboard", "Instructor");
        }
        else if (ViewBag.CurrentUser.IsStudent)
        {
            dashboardUrl = Url.Action("Dashboard", "Student");
        }
    }
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0"><i class="bi bi-shield-lock-fill me-2"></i>Access Denied</h3>
                </div>
                <div class="card-body text-center">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-slash-circle-fill"></i>
                    </div>
                    <h4 class="fw-bold">You don’t have permission to access this page.</h4>
                    <p class="text-muted mb-4">If you believe this is an error, please contact your administrator.</p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        @if (!string.IsNullOrEmpty(dashboardUrl))
                        {
                            <a href="@dashboardUrl" class="btn btn-primary">
                                <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
                            </a>
                        }
                        @Html.ActionLink("Go to Home", "Index", "Home", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.js"></script>
}
