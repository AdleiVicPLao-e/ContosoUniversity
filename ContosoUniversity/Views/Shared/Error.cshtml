@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0"><i class="bi bi-bug-fill me-2"></i>Something Went Wrong</h3>
                </div>
                <div class="card-body text-center">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h4 class="fw-bold mb-3">An error occurred while processing your request.</h4>

                    @if (Model != null)
                    {
                        <div class="alert alert-warning text-start small">
                            <strong>Controller:</strong> @Model.ControllerName<br />
                            <strong>Action:</strong> @Model.ActionName<br />
                            <strong>Exception:</strong> @Model.Exception.Message
                        </div>
                    }

                    <p class="text-muted mb-4">Please try again later or contact support if the issue persists.</p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-circle me-1"></i> Go Back
                        </a>
                        @Html.ActionLink("Go to Home", "Index", "Home", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.js"></script>
}
