@model ContosoUniversity.ViewModels.ProfileViewModel

@{
    ViewBag.Title = "My Profile";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="bi bi-person-circle me-2"></i>My Profile
                </h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("MyProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    <div class="row mb-3">
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.FirstMidName, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.FirstMidName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FirstMidName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Primary Role</label>
                            <div class="form-control bg-light">
                                <span class="badge bg-@GetRoleBadgeColor(Model.PrimaryRole)">@Model.PrimaryRole</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">All Roles</label>
                            <div class="form-control bg-light">
                                @if (Model.IsAdministrator)
                                {
                                    <span class="badge bg-danger me-1">Administrator</span>
                                }
                                @if (Model.IsInstructor)
                                {
                                    <span class="badge bg-warning me-1">Instructor</span>
                                }
                                @if (Model.IsStudent)
                                {
                                    <span class="badge bg-info me-1">Student</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Update Profile
                        </button>
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary">
                            <i class="bi bi-shield-lock me-2"></i>Change Password
                        </a>
                        <a href="@Url.Action("Dashboard", Model.PrimaryRole.ToString())" class="btn btn-outline-dark ms-auto">
                            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-info-circle me-2"></i>Profile Information
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>User ID:</strong>
                    <div class="text-muted">@Model.ID</div>
                </div>
                <div class="mb-3">
                    <strong>Full Name:</strong>
                    <div class="text-muted">@Model.FullName</div>
                </div>
                <div class="mb-3">
                    <strong>Username:</strong>
                    <div class="text-muted">@Model.UserName</div>
                </div>
                <div class="mb-3">
                    <strong>Account Status:</strong>
                    <div>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetRoleBadgeColor(ContosoUniversity.Models.Person.UserRole role)
    {
        switch (role)
        {
            case ContosoUniversity.Models.Person.UserRole.Administrator:
                return "danger";
            case ContosoUniversity.Models.Person.UserRole.Instructor:
                return "warning";
            case ContosoUniversity.Models.Person.UserRole.Student:
                return "info";
            default:
                return "secondary";
        }
    }
}