@model dynamic

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="card shadow-lg" style="width: 400px;">
        <div class="card-header text-center bg-primary text-white py-3">
            <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>Contoso University Login</h3>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        @Html.TextBox("username", null, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your username",
                            required = "required",
                            autocomplete = "username"
                        })
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        @Html.Password("password", null, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your password",
                            required = "required",
                            autocomplete = "current-password"
                        })
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe">
                    <label class="form-check-label" for="rememberMe">Remember me</label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-0" })
                </div>
            }

            <div class="text-center mt-4">

                <div class="border-top pt-3">
                    <p class="text-muted mb-1 fw-bold">Demo Accounts</p>

                    <p class="mb-1">
                        <span class="badge bg-danger me-1">Admin</span>
                        <code>admin / password123</code>
                    </p>
                    <p class="mb-1">
                        <span class="badge bg-warning text-dark me-1">Instructor</span>
                        <code>instructor / password123</code>
                    </p>
                    <p class="mb-0">
                        <span class="badge bg-info text-dark me-1">Student</span>
                        <code>student / password123</code>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .card {
        border-radius: 1rem;
        border: none;
    }

    .btn {
        border-radius: 0.5rem;
    }

    .input-group-text {
        background-color: #f8f9fa;
    }

    .min-vh-100 {
        min-height: 100vh;
    }

    code {
        font-size: 0.875rem;
    }
</style>

@section scripts {
    <script>
        // Client-side validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
        })();
    </script>
}
