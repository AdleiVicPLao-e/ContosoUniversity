@model IEnumerable<ContosoUniversity.Models.Course>

@{
    ViewBag.Title = "My Courses";
}

<div class="container mt-4">
    <h2 class="mb-3">My Courses</h2>

    @using (Html.BeginForm("MyCourses", "Instructor", FormMethod.Get))
    {
        <div class="row mb-4">
            <div class="col-auto">
                @Html.DropDownList("status", ViewBag.StatusFilter as SelectList, new { @class = "form-select" })
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
    }

    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-@(course.IsActive ? "success" : "warning")">
                    <div class="card-header fw-bold">@course.Title</div>
                    <div class="card-body">
                        <p><strong>Course ID:</strong> @course.CourseID</p>
                        <p><strong>Department:</strong> @course.Department.Name</p>
                        <p><strong>Credits:</strong> @course.Credits</p>
                        <p>
                            <strong>Enrolled:</strong>
                            <span class="badge bg-@(course.EnrolledStudents > 0 ? "primary" : "secondary")">
                                @course.EnrolledStudents / @course.Capacity
                            </span>
                        </p>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge bg-@(
                                course.Status == "Active" ? "success" :
                                course.Status == "Full" ? "warning" : "secondary"
                            )">@course.Status</span>
                        </p>

                        @if (!string.IsNullOrEmpty(course.Description))
                        {
                            <p class="small text-muted">@course.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-light">
                        <div class="d-grid gap-2">
                            @Html.ActionLink("View Students", "CourseStudents", new { id = course.CourseID }, new { @class = "btn btn-primary btn-sm" })
                            @Html.ActionLink("Details", "CourseDetails", new { id = course.CourseID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            <h5>No Courses Found</h5>
            <p>You are not assigned to any courses matching your filter criteria.</p>
        </div>
    }

    <div class="mt-4">
        @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
