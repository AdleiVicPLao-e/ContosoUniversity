@model IEnumerable<ContosoUniversity.Models.Course>

@{
    ViewBag.Title = "My Teaching Schedule";
}

<div class="container mt-4">
    <h2 class="mb-4">My Teaching Schedule</h2>

    <div class="card shadow-sm">
        <div class="card-header bg-light fw-bold">Current Semester Schedule</div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Course ID</th>
                                <th>Department</th>
                                <th>Credits</th>
                                <th>Enrolled</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>@course.Title</td>
                                    <td>@course.CourseID</td>
                                    <td>@course.Department.Name</td>
                                    <td>@course.Credits</td>
                                    <td>@course.EnrolledStudents</td>
                                    <td>@course.Capacity</td>
                                    <td>
                                        <span class="badge bg-@(
                                            course.Status == "Active" ? "success" :
                                            course.Status == "Full" ? "warning" : "secondary"
                                        )">@course.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            @Html.ActionLink("Students", "CourseStudents", new { id = course.CourseID }, new { @class = "btn btn-sm btn-primary" })
                                            @Html.ActionLink("Details", "CourseDetails", new { id = course.CourseID }, new { @class = "btn btn-sm btn-outline-secondary" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Schedule Summary</h5>
                        <p><strong>Total Courses:</strong> @Model.Count()</p>
                        <p><strong>Total Students:</strong> @Model.Sum(c => c.EnrolledStudents)</p>
                        <p><strong>Total Credits:</strong> @Model.Sum(c => c.Credits)</p>
                        <p><strong>Average Class Size:</strong> @Model.Average(c => c.EnrolledStudents).ToString("F1")</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <h5>No Active Courses</h5>
                    <p>You are not currently assigned to any active courses this semester.</p>
                </div>
            }
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("View All My Courses", "MyCourses", null, new { @class = "btn btn-primary" })
    </div>
</div>
