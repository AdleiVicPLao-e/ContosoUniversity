@model ContosoUniversity.ViewModels.InstructorDashboardViewModel

@{
    ViewBag.Title = "Instructor Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Welcome, @Model.Instructor.FirstMidName!</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Students</h5>
                    <h2>@Model.TotalStudents</h2>
                    <p class="mb-0">Across all courses</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Active Courses</h5>
                    <h2>@Model.ActiveCourses</h2>
                    <p class="mb-0">Currently teaching</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Average Students</h5>
                    <h2>@Model.AverageStudentsPerCourse.ToString("F1")</h2>
                    <p class="mb-0">Per course</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Courses Needing Grades</h5>
                    <h2>@Model.CoursesNeedingGrades</h2>
                    <p class="mb-0">Require attention</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    Upcoming Deadlines
                </div>
                <div class="card-body">
                    @if (Model.UpcomingDeadlines.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var deadline in Model.UpcomingDeadlines)
                            {
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="bi bi-clock text-warning me-2"></i> @deadline
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No upcoming deadlines</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold">
                    Instructor Information
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Instructor.FullName</dd>

                        <dt class="col-sm-4">Username:</dt>
                        <dd class="col-sm-8">@Model.Instructor.UserName</dd>

                        <dt class="col-sm-4">Hire Date:</dt>
                        <dd class="col-sm-8">@Model.Instructor.HireDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Specialization:</dt>
                        <dd class="col-sm-8">@(Model.Instructor.Specialization ?? "Not specified")</dd>

                        <dt class="col-sm-4">Office:</dt>
                        <dd class="col-sm-8">@(Model.Instructor.OfficeAssignment?.Location ?? "No office assigned")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    Recent Enrollments
                </div>
                <div class="card-body">
                    @if (Model.RecentEnrollments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var enrollment in Model.RecentEnrollments)
                            {
                                <div class="list-group-item">
                                    <h6 class="mb-1 fw-bold">@enrollment.Student.FullName</h6>
                                    <small class="text-muted">
                                        Enrolled in <strong>@enrollment.Course.Title</strong><br />
                                        @enrollment.Course.Department.Name
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recent enrollments</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold">
                    Quick Actions
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @Html.ActionLink("View My Courses", "MyCourses", null, new { @class = "btn btn-primary" })
                        @Html.ActionLink("My Teaching Schedule", "MySchedule", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>
