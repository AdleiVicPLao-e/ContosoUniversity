@model ContosoUniversity.Models.Course

@{
    ViewBag.Title = "Course Details - " + Model.Title;
}

<h2>@Model.Title</h2>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Course Information</h3>
            </div>
            <div class="panel-body">
                <dl class="dl-horizontal">
                    <dt>Course ID:</dt>
                    <dd>@Model.CourseID</dd>

                    <dt>Title:</dt>
                    <dd>@Model.Title</dd>

                    <dt>Department:</dt>
                    <dd>@Model.Department.Name</dd>

                    <dt>Credits:</dt>
                    <dd>@Model.Credits</dd>

                    <dt>Capacity:</dt>
                    <dd>@Model.Capacity students</dd>

                    <dt>Enrolled:</dt>
                    <dd>@Model.EnrolledStudents students</dd>

                    <dt>Available Spots:</dt>
                    <dd>@Model.AvailableSpots</dd>

                    <dt>Status:</dt>
                    <dd>
                        <span class="label label-@(Model.IsActive ? "success" : "default")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>

                    <dt>Fill Rate:</dt>
                    <dd>@Model.FillRate.ToString("P0")</dd>
                </dl>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <dt>Description:</dt>
                    <dd>@Model.Description</dd>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Teaching Team</h3>
            </div>
            <div class="panel-body">
                @if (Model.Instructors.Any())
                {
                    <ul class="list-group">
                        @foreach (var instructor in Model.Instructors)
                        {
                            <li class="list-group-item">
                                <strong>@instructor.FullName</strong>
                                @if (!string.IsNullOrEmpty(instructor.Specialization))
                                {
                                    <br /><small class="text-muted">@instructor.Specialization</small>
                                }
                                @if (instructor.OfficeAssignment != null)
                                {
                                    <br /><small class="text-muted">Office: @instructor.OfficeAssignment.Location</small>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No instructors assigned to this course.</p>
                }
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Quick Actions</h3>
            </div>
            <div class="panel-body">
                <div class="btn-group-vertical" style="width: 100%;">
                    @Html.ActionLink("View Students", "CourseStudents", new { id = Model.CourseID }, new { @class = "btn btn-primary btn-block text-left" })
                    @Html.ActionLink("Back to My Courses", "MyCourses", null, new { @class = "btn btn-default btn-block text-left" })
                    @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-default btn-block text-left" })
                </div>
            </div>
        </div>
    </div>
</div>