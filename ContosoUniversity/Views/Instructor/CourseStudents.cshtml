@model ContosoUniversity.Models.Course

@{
    ViewBag.Title = "Course Students - " + Model.Title;
}

<div class="container mt-4">
    <h2 class="mb-3">Students in @Model.Title</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">Student Roster</div>
        <div class="card-body">
            @if (Model.Enrollments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Student Name</th>
                                <th>Username</th>
                                <th>Enrollment Date</th>
                                <th>Grade</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments)
                            {
                                <tr>
                                    <td>@enrollment.Student.FullName</td>
                                    <td>@enrollment.Student.UserName</td>
                                    <td>@enrollment.Student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge bg-@(enrollment.Grade.HasValue ? "success" : "warning")">
                                            @(enrollment.Grade?.ToString() ?? "No Grade")
                                        </span>
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("UpdateGrade", "Instructor", FormMethod.Post, new { @class = "d-flex align-items-center gap-2" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("enrollmentId", enrollment.EnrollmentID)
                                            @Html.DropDownList("grade",
                                                Enum.GetValues(typeof(ContosoUniversity.Models.Grade))
                                                    .Cast<ContosoUniversity.Models.Grade>()
                                                    .Select(g => new SelectListItem
                                                    {
                                                        Text = g.ToString(),
                                                        Value = ((int)g).ToString(),
                                                        Selected = enrollment.Grade == g
                                                    }),
                                                "Select Grade",
                                                new { @class = "form-select form-select-sm w-auto" })
                                            <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Course Statistics</h5>
                        <p><strong>Total Students:</strong> @Model.Enrollments.Count</p>
                        <p><strong>Graded:</strong> @Model.Enrollments.Count(e => e.Grade.HasValue)</p>
                        <p><strong>Ungraded:</strong> @Model.Enrollments.Count(e => !e.Grade.HasValue)</p>
                        <p><strong>Capacity:</strong> @Model.Enrollments.Count / @Model.Capacity</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <h5>No Students Enrolled</h5>
                    <p>No students are currently enrolled in this course.</p>
                </div>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mt-3 d-flex gap-2">
        @Html.ActionLink("Back to My Courses", "MyCourses", null, new { @class = "btn btn-outline-secondary" })
        @Html.ActionLink("Back to Dashboard", "Dashboard", null, new { @class = "btn btn-primary" })
    </div>
</div>
